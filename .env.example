# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Comma-separated exact origins. Production example: https://ops.example.com
CORS_ORIGINS=http://localhost:3000

# Authentication: development permits x-user-id; production requires Firebase.
AUTH_MODE=development
FIREBASE_PROJECT_ID=
# Render: Base64 of the complete service-account JSON. Never commit its value.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Production: absolute path to a service-account JSON file stored outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Neon pooled URL for the running API and direct URL for Prisma migrations.
# Add connection_limit=5 and pool_timeout=10 to the pooled URL for this small VM.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Vite variables are embedded into the static frontend at build time.
VITE_API_URL=http://localhost:4000/api
VITE_AUTH_MODE=development
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
