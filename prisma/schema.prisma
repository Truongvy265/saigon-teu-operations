generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  MANAGER
  MEMBER
}
enum ShowStatus {
  PLANNING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum ShowRole {
  PM
  PA1
  PA2
  PA3
  SE
  SSE
  PE
  SAE
  PRODUCTION
  SOCIAL
  TALENT_ASSISTANT
  OTHER
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  STUCK
  DONE
}
enum TaskPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  avatarUrl String?
  department String?
  companyRole CompanyRole @default(MEMBER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdShows Show[] @relation("ShowCreator")
  memberships ShowMember[]
  createdTasks Task[] @relation("TaskCreator")
  assignments TaskAssignee[]
  deliverables TaskDeliverable[]
}

model Show {
  id String @id @default(cuid())
  name String
  code String?
  description String?
  showDate DateTime @db.Date
  startTime String?
  endTime String?
  city String
  venue String
  scale String?
  goal String?
  status ShowStatus @default(PLANNING)
  createdById String
  createdBy User @relation("ShowCreator", fields: [createdById], references: [id])
  members ShowMember[]
  tasks Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShowMember {
  id String @id @default(cuid())
  showId String
  userId String
  role ShowRole
  note String?
  createdAt DateTime @default(now())
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([showId, userId])
  @@index([showId])
}

model Task {
  id String @id @default(cuid())
  showId String
  title String
  description String?
  category String?
  phase String?
  department String?
  startDate DateTime? @db.Date
  plannedDeadline DateTime
  currentDeadline DateTime
  priority TaskPriority @default(NORMAL)
  status TaskStatus @default(TODO)
  progressPercent Int @default(0)
  stuckReason String?
  completedAt DateTime?
  createdById String
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdBy User @relation("TaskCreator", fields: [createdById], references: [id])
  assignees TaskAssignee[]
  deliverables TaskDeliverable[]
  predecessors TaskDependency[] @relation("Successor")
  successors TaskDependency[] @relation("Predecessor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([showId, status])
}

model TaskAssignee {
  taskId String
  userId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([taskId, userId])
}

model TaskDeliverable {
  id String @id @default(cuid())
  taskId String
  title String?
  url String
  submittedById String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User @relation(fields: [submittedById], references: [id])
  createdAt DateTime @default(now())
}

model TaskDependency {
  id String @id @default(cuid())
  predecessorTaskId String
  successorTaskId String
  lagDays Int @default(0)
  autoAdjust Boolean @default(false)
  predecessor Task @relation("Predecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successor Task @relation("Successor", fields: [successorTaskId], references: [id], onDelete: Cascade)
  @@unique([predecessorTaskId, successorTaskId])
}
